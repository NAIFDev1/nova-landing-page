  "components": [
    {
      "name": "Citron action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "New task action with hover, press, disabled, and keyboard feedback.",
      "html": "<button class=\"ds-primary\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>New task</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:40px;padding:11px 16px;border:0;border-radius:7px;font:500 12px/1.4 'Stack Sans Text',Arial,sans-serif;background:var(--accent,#e1ee8d);color:var(--ink,#2d342b);cursor:pointer;transition:background .15s,transform .15s}.ds-primary:hover{background:#d4e477}.ds-primary:active{transform:translateY(1px)}.ds-primary:focus-visible{outline:2px solid var(--ink,#2d342b);outline-offset:4px}.ds-primary:disabled{background:#e4e7dc;color:#61685b;cursor:not-allowed}@media(max-width:540px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Outlined action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A quiet supporting action, such as clearing filters or opening a screen.",
      "html": "<button class=\"ds-secondary\">Clear filters</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:40px;padding:11px 16px;border:1px solid var(--control,#d8ddd0);border-radius:7px;font:500 12px/1.4 'Stack Sans Text',Arial,sans-serif;background:var(--sheet,#fff);color:var(--ink,#2d342b);cursor:pointer;transition:background .15s,transform .15s}.ds-secondary:hover{background:var(--surface,#f5f6f1)}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:focus-visible{outline:2px solid var(--ink,#2d342b);outline-offset:4px}@media(max-width:540px){.ds-secondary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Olive action",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Form submission and workspace entry from supporting screens.",
      "html": "<button class=\"ds-dark\">Add task <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-dark{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:40px;padding:11px 16px;border:0;border-radius:7px;font:500 12px/1.4 'Stack Sans Text',Arial,sans-serif;background:var(--ink,#2d342b);color:var(--sheet,#fff);cursor:pointer;transition:background .15s,transform .15s}.ds-dark:hover{background:#454e40}.ds-dark:active{transform:translateY(1px)}.ds-dark:focus-visible{outline:2px solid var(--ink,#2d342b);outline-offset:4px}@media(max-width:540px){.ds-dark{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-dark{transition:none}}"
    },
    {
      "name": "Task search",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Compact search field with an inline SVG and a visible keyboard outline.",
      "html": "<label class=\"ds-search\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Search tasks in this project\" type=\"search\" placeholder=\"Find a task\"/></label>",
      "css": ".ds-search{position:relative;display:inline-flex;align-items:center}.ds-search>svg{position:absolute;left:11px;pointer-events:none;color:var(--secondary,#626b5d)}.ds-search input{width:180px;min-height:36px;padding:8px 12px 8px 33px;border:1px solid var(--line,#e7e9e0);border-radius:6px;font:400 11px 'Stack Sans Text',Arial,sans-serif;background:var(--sheet,#fff);color:var(--ink,#2d342b);caret-color:var(--ink,#2d342b)}.ds-search input::placeholder{color:var(--secondary,#626b5d)}.ds-search input:focus-visible{outline:2px solid var(--ink,#2d342b);outline-offset:4px}.ds-search input::selection{background:var(--accent,#e1ee8d);color:var(--ink,#2d342b)}@media(max-width:540px){.ds-search input{min-height:44px;font-size:12px}}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Active project route in the neutral sidebar; native anchor semantics remain intact.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace navigation preview\"><a class=\"ds-nav-item ds-nav-active\" href=\"#/product\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M3 7V5h6l2 2h10v13H3Z\"/></svg>Website launch</a><a class=\"ds-nav-item\" href=\"#/design\">Brand refresh</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;width:192px;padding:8px;background:var(--ground,#eeefe9)}.ds-nav-item{display:flex;align-items:center;gap:10px;min-height:41px;padding:10px 12px;border-radius:7px;font:400 11px 'Stack Sans Text',Arial,sans-serif;color:var(--secondary,#626b5d);text-decoration:none;transition:background .15s,color .15s}.ds-nav-item:hover{background:#e5e8dd;color:var(--ink,#2d342b)}.ds-nav-active{background:#e0e4d5;color:var(--ink,#2d342b)}.ds-nav-item:focus-visible{outline:2px solid var(--ink,#2d342b);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
    },
    {
      "name": "Task card",
      "kind": "card",
      "refersTo": "task-card",
      "description": "White task sheet with a complete/reopen title control, owner, category, and due notation. Preview is static.",
      "html": "<article class=\"ds-task\"><button class=\"ds-task-toggle\" aria-label=\"Complete Review with the whole team\" aria-pressed=\"false\"><svg width=\"20\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9aa18e\" stroke-width=\"1.6\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/></svg><span>Review with the whole team</span></button><span class=\"ds-task-category\">Review</span><div class=\"ds-task-footer\"><span class=\"ds-person\"><span class=\"ds-avatar\">A</span>Alex</span><span>Thu</span></div></article>",
      "css": ".ds-task{max-width:330px;padding:16px;border:1px solid var(--line,#e7e9e0);border-radius:7px;background:var(--sheet,#fff);color:var(--ink,#2d342b);font-family:'Stack Sans Text',Arial,sans-serif}.ds-task-toggle{display:flex;align-items:flex-start;gap:9px;min-height:44px;width:100%;padding:0;border:0;background:transparent;color:var(--ink,#2d342b);text-align:left;font:500 14px/1.5 'Stack Sans Text',Arial,sans-serif;cursor:pointer}.ds-task-toggle svg{flex-shrink:0}.ds-task-toggle svg:hover{stroke:var(--ink,#2d342b)}.ds-task-toggle:focus-visible{outline:2px solid var(--ink,#2d342b);outline-offset:4px}.ds-task-category{display:block;margin:12px 0 0 29px;color:var(--secondary,#626b5d);font-size:11px;line-height:1.5}.ds-task-footer{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:23px;font-size:11px;color:var(--secondary,#626b5d)}.ds-person{display:inline-flex;gap:7px;align-items:center}.ds-avatar{display:inline-flex;align-items:center;justify-content:center;width:25px;height:25px;border-radius:50%;background:#ebdfd4;color:#414b37}@media(max-width:540px){.ds-task{padding:17px}.ds-task-toggle{font-size:15px;gap:10px}}"
    },
    {
      "name": "Task status",
      "kind": "input",
      "refersTo": "status-selector",
      "description": "A native select changes status without dragging.",
      "html": "<div class=\"ds-status\"><select aria-label=\"Status of preview task\"><option>Ready</option><option>In progress</option><option>Done</option></select><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></div>",
      "css": ".ds-status{position:relative;width:250px;color:var(--secondary,#626b5d)}.ds-status select{appearance:none;width:100%;min-height:31px;padding:6px 28px 6px 9px;border:0;border-radius:4px;background:var(--surface,#f5f6f1);color:var(--secondary,#626b5d);font:400 11px 'Stack Sans Text',Arial,sans-serif;cursor:pointer;accent-color:var(--accent-dark,#788639)}.ds-status>svg{position:absolute;right:10px;top:10px;pointer-events:none}.ds-status select:hover{background:#ecefe3;color:var(--ink,#2d342b)}.ds-status select:focus-visible{outline:2px solid var(--ink,#2d342b);outline-offset:4px}@media(max-width:540px){.ds-status select{min-height:44px;font-size:12px;padding-left:10px}.ds-status>svg{top:13px}}"
    },
    {
      "name": "Recommended plan tag",
      "kind": "chip",
      "refersTo": "plan-tag",
      "description": "Static recommendation annotation, not an interactive filter.",
      "html": "<span class=\"ds-plan-tag\">Team favorite</span>",
